{
	"name": "kn-upload",
	"author": "Florent VIALATTE",
	"version": "6.0.0",
	"description": "Drag & Drop upload library based on KnHttpJs, written in TypeScript",
	"main": "./dist/kn-upload.js",
	"module": "./dist/kn-upload.js",
	"types": "./dist/types/kn-upload.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/kn-upload.d.ts",
			"import": "./dist/kn-upload.js"
		},
		"./vue": {
			"types": "./dist/types/vue.d.ts",
			"import": "./dist/vue.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && vue-tsc --noEmit -p samples/vue/tsconfig.json",
		"build": "tsc --noEmit && tsc -p tsconfig.node.json && vite build && vite build --mode vue && tsc",
		"dev": "vite build --watch",
		"samples": "vite --config samples/vite.config.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Karewan/KnUpload.git"
	},
	"keywords": [
		"upload",
		"drag and drop",
		"file",
		"typescript",
		"vue"
	],
	"peerDependencies": {
		"kn-http": "^4.0.0",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^24.13.6",
		"@vitejs/plugin-vue": "^6.0.9",
		"kn-http": "^4.0.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.0",
		"vue": "^3.5.43",
		"vue-tsc": "^3.3.11"
	}
}
